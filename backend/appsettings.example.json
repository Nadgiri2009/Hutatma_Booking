{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=YOUR_DATABASE;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Key": "YOUR_RAZORPAY_KEY",
    "Issuer": "HutatmaBookingAPI",
    "Audience": "HutatmaBookingClient",
    "ExpiryHours": "8"
  },
  "AllowedOrigins": "http://localhost:3000,https://yourdomain.com",
  "FileStorage": {
    "UploadPath": "wwwroot/uploads",
    "MaxFileSizeMB": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PaymentGateway": {
    "Provider": "Razorpay",
    "BaseUrl": "https://example.test",
    "MerchantId": "",
    "MerchantKey": "",
    "CallbackUrl": "",
    "Razorpay": {
      "Key": "YOUR_RAZORPAY_KEY",
      "Secret": "YOUR_RAZORPAY_SECRET",
      "WebhookSecret": "YOUR_RAZORPAY_WEBHOOK_SECRET"
    }
  },
  "PaymentNotifications": {
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": "587",
      "EnableSsl": "true",
      "Username": "YOUR_SMTP_USERNAME",
      "Password": "YOUR_SMTP_PASSWORD",
      "FromEmail": "YOUR_FROM_EMAIL"
    },
    "Twilio": {
  "AccountSid": "YOUR_TWILIO_ACCOUNT_SID",
  "AuthToken": "YOUR_TWILIO_AUTH_TOKEN",
  "FromNumber": "YOUR_TWILIO_FROM_NUMBER"
}
  }
}
