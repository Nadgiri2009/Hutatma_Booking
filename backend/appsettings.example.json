{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=HutatmaBookingDB;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;TrustServerCertificate=True;Integrated Security=False"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_64_CHAR_CRYPTOGRAPHICALLY_RANDOM_KEY",
    "Issuer": "HutatmaBookingAPI",
    "Audience": "HutatmaBookingClient",
    "ExpiryHours": "8"
  },
  "AllowedOrigins": "http://localhost:3000,https://yourdomain.com",
  "FileStorage": {
    "UploadPath": "wwwroot/uploads",
    "MaxFileSizeMB": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PaymentGateway": {
    "Provider": "Razorpay",
    "BaseUrl": "https://example.test",
    "MerchantId": "",
    "MerchantKey": "",
    "CallbackUrl": "",
    "Razorpay": {
      "Key": "REPLACE_WITH_RAZORPAY_KEY",
      "Secret": "REPLACE_WITH_RAZORPAY_SECRET",
      "WebhookSecret": "REPLACE_WITH_RAZORPAY_WEBHOOK_SECRET"
    }
  },
  "PaymentNotifications": {
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": "587",
      "EnableSsl": "true",
      "Username": "YOUR_SMTP_USERNAME",
      "Password": "YOUR_SMTP_PASSWORD",
      "FromEmail": "YOUR_FROM_EMAIL"
    },
    "Twilio": {
      "AccountSid": "YOUR_TWILIO_ACCOUNT_SID",
      "AuthToken": "YOUR_TWILIO_AUTH_TOKEN",
      "FromNumber": "+10000000000"
    }
  }
}
