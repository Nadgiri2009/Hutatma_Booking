<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HutatmaBooking.API</RootNamespace>
    <DefaultItemExcludesInProjectFolder>$(DefaultItemExcludesInProjectFolder);ConflictValidation\**;FinalValidation\**;ServerPaymentValidation\**;VenueCapacityValidation\**;tools\**;wwwroot\uploads\**</DefaultItemExcludesInProjectFolder>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="DTOs\Phase5Phase6DTOs.cs" />
    <Compile Remove="Models\Phase5Phase6Models.cs" />
    <Compile Remove="Services\Phase5Phase6Services.cs" />
    <Compile Remove="Services\Interfaces\IPhase5Phase6Services.cs" />
    <Content Update="appsettings*.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Content Update="wwwroot\SMC.png">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2025.12.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer"       Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools"           Version="8.0.0" />
    <PackageReference Include="BCrypt.Net-Next"                               Version="4.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore"                        Version="6.5.0" />
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.1" />
    <PackageReference Include="Serilog.AspNetCore"                            Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.StaticFiles"              Version="2.2.0" />
  </ItemGroup>
</Project>
