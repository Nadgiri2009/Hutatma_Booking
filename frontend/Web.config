<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="HutatmaBooking" connectionString="" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="HostAuthAuthenticatedSessionKey" value="HostIsAuthenticated" />
    <add key="HostAuthRoleSessionKey" value="HostDepartmentRole" />
    <add key="HostAuthAllowedRoles" value="Admin,Staff" />
    <add key="HostAuthStaffScreens" value="admin/bookings,admin/slot-availability,admin/payments,admin/complaints,admin/cancellations,admin/refunds,admin/receipts" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="5120" />
    <pages controlRenderingCompatibilityVersion="4.0" />
    <customErrors mode="RemoteOnly" />
    <sessionState mode="InProc" cookieless="UseCookies" timeout="20" />
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Site.aspx" />
      </files>
    </defaultDocument>
    <handlers>
      <add name="ASPX" path="*.aspx" verb="*" type="System.Web.UI.PageHandlerFactory" resourceType="Unspecified" />
    </handlers>
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>
</configuration>
